<head>
    <%- include('pieces/metadata') %>
    <title>Reboot 16 | Login</title>
    <link rel="preconnect" href="https://challenges.cloudflare.com" />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer nonce="<%= nonce %>"></script>
</head>

<body>
    <%- include('pieces/header') %>

    <div class="content">
        <h1 class="authTitle">Login</h1>
        <br><br>
        <form id="loginForm" class="authForm" method="POST" action="javascript:void(0);">
            <h2 id="authError" class="authError" style="color: #c00; display: none;"></h2>
            
            <h1>Username</h1>
            <input type="text" name="username" placeholder="Username" autocomplete="username" maxlength="64" required> <br><br>

            <h1>Password</h1>
            <input type="password" name="password" placeholder="Password" autocomplete="current-password" maxlength="128" required> <br><br>
                
            <div class="cf-turnstile" data-sitekey="0x4AAAAAAFTaiTGdkfynblAX"></div> <br><br>

            <input type="submit" id="loginSubmit" value="Login" style="padding: 5px 30px;">
        </form>
    </div>

    <%- include('pieces/footer') %>

    <script>
        const form = document.getElementById('loginForm');
        const errorBox = document.getElementById('authError');
        const submitBtn = document.getElementById('loginSubmit');

        function showError(message) {
            errorBox.textContent = message;
            errorBox.style.display = 'block';
        }

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            errorBox.style.display = 'none';

            const username = form.username.value.trim();
            const password = form.password.value;

            submitBtn.disabled = true;
            submitBtn.value = 'Logging in...';

            try {
                const formData = new FormData(form);
                const turnstileResponse = formData.get('cf-turnstile-response');

                const res = await fetch('/api/login-user', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username, password, token: turnstileResponse })
                });

                let data = {};
                try { data = await res.json(); } catch (_) {}

                if (res.ok) {
                    window.location.href = '/';
                    return;
                }

                if (data.banned && data.redirect) {
                    window.location.href = data.redirect;
                    return;
                }

                showError(data.error || 'Something went wrong. Please try again.');
            } catch (err) {
                showError("Couldn't reach the server. Please try again.");
            }

            submitBtn.disabled = false;
            submitBtn.value = 'Login';
        });
    </script>
</body>
