<head>
    <%- include('pieces/metadata') %>
    <title>Reboot 16 | Settings</title>
</head>

<body>
    <%- include('pieces/header') %>

    <div class="content" style="text-align: center;">
        <h1 class="authTitle">Settings</h1>
        <br><br>

        <h2>Bio</h2>
        <h3 id="settingsError" style="color: #c00; display: none;"></h3>
        <h3 id="settingsSuccess" style="color: #0c0; display: none;"></h3>

        <form id="bioForm" method="POST" action="/api/update-bio">
            <input id="bioInput" style="width: 500px;" type="text" name="bio" value="<%= bio %>" placeholder="This is your bio! Write here to tell people about yourself. (Max 200 Characters)" maxlength="200">
            <br><br>
            <input type="submit" id="bioSubmit" value="Change Bio">
        </form>

        <h2>Username</h2>
        <h3 id="usernameError" style="color: #c00; display: none;"></h3>
        <h3 id="usernameSuccess" style="color: #0c0; display: none;"></h3>

        <form id="usernameForm" method="POST" action="/api/update-username">
            <input id="usernameInput" style="width: 500px;" type="text" name="username" placeholder="Enter new username (can be changed once every 2 weeks)" required>
            <br><br>
            <input type="submit" id="usernameSubmit" value="Change Username">
        </form>
    </div>

    <%- include('pieces/footer') %>

    <script nonce="<%= nonce %>">
        const bioForm = document.getElementById('bioForm');
        const bioInput = document.getElementById('bioInput');
        const bioErrorBox = document.getElementById('settingsError');
        const bioSuccessBox = document.getElementById('settingsSuccess');

        bioForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            bioErrorBox.style.display = 'none';
            bioSuccessBox.style.display = 'none';

            try {
                const res = await fetch('/api/update-bio', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ bio: bioInput.value })
                });

                const data = await res.json();

                if (!res.ok) {
                    bioErrorBox.textContent = data.error || 'Failed to update bio.';
                    bioErrorBox.style.display = 'block';
                } else {
                    bioSuccessBox.textContent = data.message || 'Bio updated successfully!';
                    bioSuccessBox.style.display = 'block';
                }
            } catch (err) {
                bioErrorBox.textContent = "Couldn't reach the server.";
                bioErrorBox.style.display = 'block';
            }
        });

        const usernameForm = document.getElementById('usernameForm');
        const usernameInput = document.getElementById('usernameInput');
        const userErrorBox = document.getElementById('usernameError');
        const userSuccessBox = document.getElementById('usernameSuccess');

        usernameForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            userErrorBox.style.display = 'none';
            userSuccessBox.style.display = 'none';

            try {
                const res = await fetch('/api/update-username', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username: usernameInput.value })
                });

                const data = await res.json();

                if (!res.ok) {
                    userErrorBox.textContent = data.error || 'Failed to update username.';
                    userErrorBox.style.display = 'block';
                } else {
                    userSuccessBox.textContent = data.message || 'Username updated successfully!';
                    userSuccessBox.style.display = 'block';
                }
            } catch (err) {
                userErrorBox.textContent = "Couldn't reach the server.";
                userErrorBox.style.display = 'block';
            }
        });
    </script>
</body>