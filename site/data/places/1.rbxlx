		<Item class="ModuleScript" referent="RBX589F489BBA0D4EA498808A323CF2B8F0">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">modules</string>
				<ProtectedString name="Source"><![CDATA[local temp = require(script.temp)

local module = {}

function module:init()
	temp:init()
end

return module
]]></ProtectedString>
			</Properties>
			<Item class="ModuleScript" referent="RBXC8E4A0E3D785481988D6ABB0A660F59F">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">temp</string>
					<ProtectedString name="Source"><![CDATA[-- services
local runService = game:GetService("RunService")
local tweenService = game:GetService("TweenService")

-- references
local trees = workspace.trees

-- debounces
local healDeb = false
local dmgDeb = false

local module = {}

local function rotateLeaves()
	while true do
		for _, tree in pairs(trees:GetChildren()) do
			if tree:IsA("Model") then
				for _, leaf in pairs(tree:GetChildren()) do
					if leaf.Name == "leaves" and leaf:IsA("BasePart") then
							local randX = math.rad(math.random(-5, 5))
						local randY = math.rad(math.random(-5, 5))
						local randZ = math.rad(math.rad(math.random(-5, 5)))

						local targetCFrame = leaf.CFrame * CFrame.Angles(randX, randY, randZ)
						
						leaf.CFrame = targetCFrame
					end
				end
			end
		end
		wait(0.1)
	end
end

function module:init()
	rotateLeaves()
end

return module]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
